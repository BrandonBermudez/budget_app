# Copy to .env. Every variable is optional for local use.

# Session-signing key: a long random value
# (python -c "import secrets; print(secrets.token_hex(32))"). Empty = built-in dev key with a warning.
SECRET_KEY=
# 1 enables the Werkzeug debugger. Never set it outside local development.
FLASK_DEBUG=0

# Set both to require HTTP Basic Auth on every route (including /api/data).
BUDGET_APP_USER=
BUDGET_APP_PASS=

# Optional "fetch statement from email" feature (IMAP).
# Gmail address and a Gmail App Password (not your normal password).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Text contained in the subject of your bank's statement emails; required for email fetch.
STATEMENT_EMAIL_SUBJECT=
